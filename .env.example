# Site paths. Copy to .env, edit, and `set -a; . ./.env; set +a` before running.
#
# Every config path goes through ${VAR} or ${VAR:-default} expansion, so this
# file is the only place a machine's layout is written down. An undefined
# variable is left as-is and warned about rather than expanded to nothing,
# because "${ARCHIVE}/knmi" quietly becoming "/knmi" is worse than a clear stop.

# Where meteopack reads and writes raw/, canonical/, derived/ and catalog/.
# Also settable per-command with --data-root.
METEOPACK_DATA_ROOT=/vol/knmimo-nobackup/users/mrobben/data

# Fast local scratch for decompressing satellite scenes. A tmpfs is ideal; it
# must be node-local, not the shared filesystem, and big enough for
# workers x ~100 MB. Defaults to /dev/shm.
METEOPACK_SCRATCH=/dev/shm

# Pre-existing local archives, delivered by KNMI rather than downloaded.
# Leave unset if you do not have them; those sources will simply find nothing.
KNMI_RADAR_ARCHIVE=/vol/knmimo-nobackup/users/mrobben/data_raw/data/raw/knmi/nl_rdr_data_rtcor_5m_tar
KNMI_INSITU_ARCHIVE=/vol/knmimo-nobackup/users/mrobben/data_raw/data/raw/knmi/10-minute-in-situ-meteorological-observations_tar
